# Elevator backend — copy to .env and fill in (never commit real values).
# .env itself is gitignored; this file only documents variable names.

# Server port
PORT=4000

# C1 — operator token protecting all POST /api/* control endpoints.
# Empty/unset = open dev mode (plain `npm run dev` works out of the box).
# Set a long random value for ANY shared/staging/prod deployment, e.g.:
#   OPERATOR_TOKEN=<paste-long-random-string>
# Clients send it as `x-operator-token` header or `Authorization: Bearer <token>`.
OPERATOR_TOKEN=

# C3/C4 — CORS allowlist for REST + Socket.IO (comma-separated, no wildcard).
# Defaults to the local Vite dev server when unset.
ALLOWED_ORIGINS=http://localhost:5173
# Alternative single-origin form (used only when ALLOWED_ORIGINS is empty):
# FRONTEND_ORIGIN=http://localhost:5173
